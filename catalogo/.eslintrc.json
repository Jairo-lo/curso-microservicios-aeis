{
  "root": true,
  "parser": "@typescript-eslint/parser", // Analiza el código TypeScript en busca de errores de sintaxis
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module" // Permite usar import/export en lugar de require()
  },
  "plugins": ["@typescript-eslint"], // Reglas específicas para TypeScript
  "extends": [
    "eslint:recommended", // Reglas base de JavaScript recomendadas
    "plugin:@typescript-eslint/recommended" // Reglas recommendadas para TypeScript
  ],
  "env": {
    "node": true, // Indica que el código corre en Node.js (permite console, process, etc.)
    "es2022": true
  },
  "rules": {
    // Abajo puedes ir añadiendo tus propias reglas de estilo.
    // Ejemplo: "@typescript-eslint/no-explicit-any": "warn"
  }
}